            "m_Id": "8f1bd640ed0a4419b60d679a66348738"
        },
        {
            "m_Id": "e330c14c493b484f9a4e8f24eab88e23"
        },
        {
            "m_Id": "ea5998da029245dfb30f0c9a919f1fcc"
        },
        {
            "m_Id": "2e7dcbfbc079434799301495ed9ad02f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "MainLight",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#if defined(UNIVERSAL_LIGHTING_INCLUDED)\r\n    float4 shadowCoord = TransformWorldToShadowCoord(WorldPos);\r\n    Light light = GetMainLight(shadowCoord);\r\n    Direction = light.direction;\r\n    Color = light.color;\r\n    Shadow = light.shadowAttenuation;\r\n#else\r\n    Direction = float3(0.5, 0.5, -0.5);\r\n    Color = float3(1, 1, 1);\r\n    Shadow = 1.0;\r\n#endif"
}

